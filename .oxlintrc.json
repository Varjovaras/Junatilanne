{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["unicorn", "typescript", "oxc", "react"],
    "categories": {
        "correctness": "error"
    },
    "settings": {
        "react": {
            "formComponents": [],
            "linkComponents": []
        }
    },
    "env": {
        "builtin": true
    },
    "globals": {},
    "ignorePatterns": [".output/**", "src/routeTree.gen.ts"]
}
